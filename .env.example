# Local stdio: x-deepresearch-auth init stores session outside the repository.
# X_DEEPRESEARCH_CONFIG_DIR=~/.config/x-deepresearch
# TWIKIT_COOKIES_FILE=~/.config/x-deepresearch/cookies.json

# HTTP requires a strong random Bearer secret (32+ characters):
X_RESEARCH_ACCESS_TOKEN=
TWIKIT_COOKIES_JSON=
TWIKIT_AUTH_TOKEN=
TWIKIT_CT0=

# By default, search is deny-by-default until explicitly configured.
ALLOWED_USERS=
ALLOW_ARBITRARY_SEARCH=false
MAX_PAGES=100
MAX_RESULTS=2000
PAGE_SIZE=20

X_MAX_CONCURRENT_REQUESTS=1
X_MIN_REQUEST_INTERVAL_SECONDS=1.0
X_RATE_LIMIT_PER_MINUTE=60
X_MAX_RETRIES=2
X_RETRY_BASE_SECONDS=1.0
X_RETRY_MAX_SECONDS=30.0

# SQLite is disabled unless explicitly configured; optional single-instance durable storage:
# X_RESEARCH_JOB_DB=~/.local/share/x-deepresearch/jobs.sqlite3
